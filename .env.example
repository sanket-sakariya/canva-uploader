# ─────────────────────────────────────────────────────────────
# Canva Connect API  (https://www.canva.com/developers/integrations)
# Create an integration, enable scopes: design:meta:read design:content:read
# Add redirect URL:  http://127.0.0.1:3000/auth/canva/callback
# ─────────────────────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/auth/canva/callback

# ─────────────────────────────────────────────────────────────
# Instagram Content Publishing  (Meta app w/ an IG *Business/Creator* account)
#
# GRAPH_HOST=graph.facebook.com  -> "Facebook Login for Business" token
#   permissions: instagram_basic, instagram_content_publish, pages_read_engagement
# GRAPH_HOST=graph.instagram.com -> "Instagram Login" (Business Login) token
#   permissions: instagram_business_basic, instagram_business_content_publish
# ─────────────────────────────────────────────────────────────
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v21.0
IG_ACCESS_TOKEN=
# Optional. If blank, the server auto-discovers it from the token on boot.
IG_USER_ID=

# ─────────────────────────────────────────────────────────────
# How Instagram gets the image bytes.
#   canva -> hand Instagram the Canva export URL directly (no tunnel needed)
#   proxy -> download the export, re-host it at PUBLIC_BASE_URL/media/<id>.jpg
#            (server must be publicly reachable: ngrok / cloudflared / deployed)
# ─────────────────────────────────────────────────────────────
MEDIA_MODE=canva
PUBLIC_BASE_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────
# Where the Canva token lives.
#   server  -> kept in .tokens.json, never sent to the browser  (recommended)
#   browser -> also returned to the page and kept in localStorage, then sent
#              back on every publish as the `x-canva-token` header
# ─────────────────────────────────────────────────────────────
TOKEN_STORE=browser

PORT=3000
JPG_QUALITY=90
LOG_LEVEL=info
