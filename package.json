{
  "name": "canva-instagram-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headlessly export a Canva design via the Canva Connect API and publish it to Instagram — without opening the Canva editor.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "publish:cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/run.ts",
    "doctor": "tsx src/doctor.ts",
    "canva:login": "tsx src/cli-ui.ts login",
    "canva:post": "tsx src/cli-ui.ts post",
    "test:ui": "tsx tests/ui-smoke.test.ts",
    "ci:publish": "tsx src/ci-publish.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
